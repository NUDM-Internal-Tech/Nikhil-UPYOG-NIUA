{
  "pageKey": "citizen-login",
  "themeType": "CITIZEN",
  "status": "DEFAULT",
  "meta": { "title": "Citizen Login - UPYOG", "locale": "en" },
  "context": {
    "hero_tag": "OFFICIAL CITIZEN SERVICES",
    "hero_title": "A single digital window\nfor municipal services",
    "hero_subtitle": "Apply for trade licenses, pay property tax, register certificates, and track applications seamlessly from anywhere.",
    "login_heading": "Citizen Login",
    "login_subheading": "Enter your 10-digit mobile number to login or register",
    "mobile_label": "Mobile Number",
    "continue_label": "Continue",
    "digilocker_label": "Register / Login with DigiLocker"
  },

  "sections": [
    {
      "id": "citizenHeroPanel",
      "layoutMode": "absolute",
      "order": 1,
      "widthPercent": 100,
      "style": { "height": "calc(100vh - 56px)", "minHeight": "calc(100vh - 56px)", "position": "relative", "overflow": "hidden" },
      "widgets": [
        {
          "id": "heroBg",
          "type": "backgroundImage",
          "position": { "x": "0%", "y": "0%", "width": "100%", "height": "100%" },
          "props": {
            "images": [
              "https://niuatt-filestore.s3.ap-south-1.amazonaws.com/pg/ADS/September/7/1788776411397KnsZEAXxpe.png"
            ],
            "alt": "Citizen Portal Background",
            "fit": "cover"
          }
        },
        {
          "id": "heroOverlay",
          "type": "overlay",
          "props": {
            "background": "linear-gradient(90deg, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.85) 32%, rgba(255, 255, 255, 0.4) 60%, rgba(255, 255, 255, 0.05) 100%)"
          }
        },
        {
          "id": "heroBadge",
          "type": "badge",
          "position": { "x": "5%", "y": "8%", "zIndex": 10 },
          "style": { "background": "rgba(168, 34, 39, 0.1)", "border": "1px solid rgba(168, 34, 39, 0.25)", "color": "#a82227", "borderRadius": "20px", "padding": "6px 14px", "fontWeight": "700", "fontSize": "11px", "letterSpacing": "0.8px" },
          "props": {
            "icon": "ShieldIcon",
            "text": "{{hero_tag}}"
          }
        },
        {
          "id": "heroHeadline",
          "type": "heading",
          "position": { "x": "5%", "y": "16%", "width": "500px", "zIndex": 10 },
          "style": { "lineHeight": "1.25", "whiteSpace": "pre-line", "letterSpacing": "-0.5px" },
          "props": {
            "text": "{{hero_title}}",
            "fontSize": "34px",
            "fontWeight": "800",
            "color": "#0F172A"
          }
        },
        {
          "id": "heroSubtitle",
          "type": "text",
          "position": { "x": "5%", "y": "31%", "width": "460px", "zIndex": 10 },
          "style": { "lineHeight": "1.6" },
          "props": {
            "text": "{{hero_subtitle}}",
            "fontSize": "15px",
            "fontWeight": "500",
            "color": "#1E293B"
          }
        },
        {
          "id": "citizenLoginCard",
          "type": "card",
          "position": { "right": "6%", "top": "5%", "width": "420px", "zIndex": 20 },
          "style": {
            "background": "#FFFFFF",
            "borderRadius": "24px",
            "boxShadow": "0 20px 40px -10px rgba(0, 0, 0, 0.12), 0 1px 3px rgba(0, 0, 0, 0.05)",
            "border": "1px solid #E2E8F0",
            "padding": "34px 28px 24px 28px",
            "position": "absolute"
          },
          "props": {
            "widgets": [
              {
                "id": "loginIcon",
                "type": "icon",
                "style": { "margin": "0 auto 10px auto" },
                "props": {
                  "name": "UserIcon",
                  "size": "26px",
                  "containerSize": "56px",
                  "shape": "circle",
                  "background": "var(--primary-main, #a82227)",
                  "color": "#FFFFFF",
                  "border": "none"
                }
              },
              {
                "id": "loginHeading",
                "type": "heading",
                "props": {
                  "text": "Citizen Login",
                  "fontSize": "24px",
                  "fontWeight": "800",
                  "align": "center",
                  "color": "#0F172A"
                }
              },
              {
                "id": "loginSubheading",
                "type": "text",
                "style": { "marginBottom": "16px", "marginTop": "4px" },
                "props": {
                  "text": "Access urban services with ease",
                  "fontSize": "14px",
                  "align": "center",
                  "color": "#64748B"
                }
              },
              {
                "id": "citizenFormSlot",
                "type": "customSlot",
                "props": { "slotName": "citizenLoginForm" }
              }
            ]
          }
        }
      ]
    }
  ]
}
